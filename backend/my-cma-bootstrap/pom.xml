<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mycma</groupId>
        <artifactId>my-cma-backend</artifactId>
        <version>1.0.0-beta</version>
    </parent>
    <artifactId>my-cma-bootstrap</artifactId>
    <packaging>jar</packaging>

    <name>My CMA — Bootstrap</name>
    <description>Spring Boot application entry point. REST controllers + config.</description>

    <dependencies>
        <!-- Application modules -->
        <dependency><groupId>com.mycma</groupId><artifactId>my-cma-application-content</artifactId></dependency>
        <dependency><groupId>com.mycma</groupId><artifactId>my-cma-application-publishing</artifactId></dependency>
        <dependency><groupId>com.mycma</groupId><artifactId>my-cma-application-analytics</artifactId></dependency>

        <!-- Infrastructure modules -->
        <dependency><groupId>com.mycma</groupId><artifactId>my-cma-infrastructure-persistence</artifactId></dependency>
        <dependency><groupId>com.mycma</groupId><artifactId>my-cma-infrastructure-social-facebook</artifactId></dependency>
        <dependency><groupId>com.mycma</groupId><artifactId>my-cma-infrastructure-ai-openai</artifactId></dependency>

        <!-- Spring Boot starters -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- OpenAPI / Swagger -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.3</version>
        </dependency>

        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
